<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:res="clr-namespace:Companion.Shell.Resources"
                    mc:Ignorable="po">

  <!-- Value Converters -->
  <res:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
  <res:RoutineStatusTextConverter x:Key="RoutineStatusTextConverter" />
  <res:RoutineToggleTextConverter x:Key="RoutineToggleTextConverter" />
  <res:RoutineStatusBgConverter x:Key="RoutineStatusBgConverter" />
  <res:RoutineStatusBorderConverter x:Key="RoutineStatusBorderConverter" />
  <res:RoutineStatusFgConverter x:Key="RoutineStatusFgConverter" />
  <res:ClipTypeTextConverter x:Key="ClipTypeTextConverter" />
  <res:ClipTypeBgConverter x:Key="ClipTypeBgConverter" />
  <res:ClipTypeBorderConverter x:Key="ClipTypeBorderConverter" />
  <res:ClipTypeFgConverter x:Key="ClipTypeFgConverter" />

  <!-- Core Palette Colors -->
  <Color x:Key="IslandBaseColor">#FF090A0D</Color>
  <Color x:Key="IslandElevatedColor">#FF111318</Color>
  <Color x:Key="IslandHoverColor">#FF1A1C22</Color>
  <Color x:Key="IslandBorderColor">#24FFFFFF</Color>
  <Color x:Key="TextPrimaryColor">#FFF5F6F8</Color>
  <Color x:Key="TextSecondaryColor">#FF9A9DA5</Color>
  <Color x:Key="TextMutedColor">#FF6F737D</Color>
  <Color x:Key="SoulCyanColor">#FF38BDF8</Color>
  <Color x:Key="SoulVioletColor">#FF818CF8</Color>
  <Color x:Key="SoulEmeraldColor">#FF34D399</Color>
  <Color x:Key="SoulAmberColor">#FFFBBF24</Color>
  <Color x:Key="SoulCrimsonColor">#FFF87171</Color>

  <!-- Legacy Surface & Accent Keys (Preserved for compatibility) -->
  <Color x:Key="SurfaceColor">#FF0E0E12</Color>
  <Color x:Key="Surface2Color">#FF18181F</Color>
  <Color x:Key="TextColor">#EBFFFFFF</Color>
  <Color x:Key="TextDimColor">#A3FFFFFF</Color>
  <Color x:Key="AccentColor">#FFFF6B6B</Color>

  <!-- Master Specification Color Tokens -->
  <Color x:Key="SurfaceBaseColor">#FF090A0D</Color>
  <Color x:Key="SurfaceElevatedColor">#FF111318</Color>
  <Color x:Key="SurfaceHoverColor">#FF1A1C22</Color>
  <Color x:Key="SurfaceBorderColor">#24FFFFFF</Color>
  <Color x:Key="SemanticSuccessColor">#FF34D399</Color>
  <Color x:Key="SemanticDangerColor">#FFF87171</Color>

  <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBaseColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SemanticSuccessBrush" Color="{StaticResource SemanticSuccessColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SemanticDangerBrush" Color="{StaticResource SemanticDangerColor}" po:Freeze="True" />

  <!-- Solid Color Brushes (Frozen for zero-allocation performance) -->
  <SolidColorBrush x:Key="IslandBaseBrush" Color="{StaticResource SurfaceBaseColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="IslandElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="IslandHoverBrush" Color="{StaticResource SurfaceHoverColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="IslandBorderBrush" Color="{StaticResource SurfaceBorderColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#59FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="SoulCyanBrush" Color="{StaticResource SoulCyanColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SoulVioletBrush" Color="{StaticResource SoulVioletColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SoulEmeraldBrush" Color="{StaticResource SemanticSuccessColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SoulAmberBrush" Color="{StaticResource SoulAmberColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SoulCrimsonBrush" Color="{StaticResource SemanticDangerColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" po:Freeze="True" />
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True" />

  <!-- Frozen flat surfaces keep the resident island light and easy to render. -->
  <SolidColorBrush x:Key="IslandGlassBrush" Color="#FF0B0C10" po:Freeze="True" />
  <SolidColorBrush x:Key="IslandSpecularBorderBrush" Color="#38FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="GlassCardBrush" Color="#FF111318" po:Freeze="True" />
  <SolidColorBrush x:Key="GlassCardHoverBrush" Color="#FF1A1C22" po:Freeze="True" />
  <SolidColorBrush x:Key="GlassCardBorderBrush" Color="#24FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="GlassCardBorderHoverBrush" Color="#40FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentGlassBrush" Color="#24FF6B6B" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="#70FF6B6B" po:Freeze="True" />
  <SolidColorBrush x:Key="TabPillActiveBrush" Color="#20FF6B6B" po:Freeze="True" />

  <!-- Segmented Tab Pill Button Style -->
  <Style x:Key="TabPillButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0,3" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="pillBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="pillBorder" Property="Background" Value="#1CFFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="pillBorder" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Typography Hierarchy Styles -->
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="MetricValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- Bento Metric Card with Specular Double-Bezel -->
  <Style x:Key="MetricCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="MetricCardCyan" TargetType="Border" BasedOn="{StaticResource MetricCard}">
    <Setter Property="BorderBrush" Value="#5538BDF8" />
  </Style>

  <Style x:Key="MetricCardViolet" TargetType="Border" BasedOn="{StaticResource MetricCard}">
    <Setter Property="BorderBrush" Value="#55818CF8" />
  </Style>

  <Style x:Key="MetricCardAmber" TargetType="Border" BasedOn="{StaticResource MetricCard}">
    <Setter Property="BorderBrush" Value="#55FBBF24" />
  </Style>

  <Style x:Key="MetricCardEmerald" TargetType="Border" BasedOn="{StaticResource MetricCard}">
    <Setter Property="BorderBrush" Value="#5534D399" />
  </Style>

  <!-- Minimalist TileButton with Kinetic Glass Elevation -->
  <Style x:Key="TileButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Background" Value="{StaticResource GlassCardHoverBrush}" />
              <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GlassCardBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="border" Property="Background" Value="{StaticResource IslandElevatedBrush}" />
              <Setter TargetName="border" Property="Opacity" Value="0.88" />
              <Setter TargetName="border" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="border" Property="Opacity" Value="0.38" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Luxury Danger Quick-Action Tile Button (Shutdown / Restart) -->
  <Style x:Key="DangerTileButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
    <Setter Property="Background" Value="#18F87171" />
    <Setter Property="BorderBrush" Value="#38F87171" />
    <Setter Property="Foreground" Value="{StaticResource SoulCrimsonBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Background" Value="#2EF87171" />
              <Setter TargetName="border" Property="BorderBrush" Value="#70F87171" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="border" Property="Background" Value="#45F87171" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Generic Button (Pill & Compact Actions) -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Background" Value="{StaticResource GlassCardHoverBrush}" />
              <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GlassCardBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="border" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="border" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Refined Glass TextBox -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource IslandElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GlassCardBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="border" Property="Background" Value="#FF171722" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Floating App Search Pill Style with Focus Glow -->
  <Style x:Key="AppSearchPillStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="border"
                  Background="#E614141E"
                  BorderBrush="{StaticResource GlassCardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="🔍" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                            VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GlassCardBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="border" Property="Background" Value="#FF171726" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Refined ListBox & ListBoxItem (No ugly default blue selection) -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="itemBorder"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="itemBorder" Property="Background" Value="#16FFFFFF" />
              <Setter TargetName="itemBorder" Property="BorderBrush" Value="#22FFFFFF" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="itemBorder" Property="Background" Value="#24FF6B6B" />
              <Setter TargetName="itemBorder" Property="BorderBrush" Value="#70FF6B6B" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Custom Dark-Glass CheckBox Style with Emerald Check -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="CheckMarkBorder"
                    Width="16" Height="16"
                    CornerRadius="4"
                    Background="#16FFFFFF"
                    BorderBrush="{StaticResource GlassCardBorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
              <Path x:Name="CheckMark"
                    Data="M 3 8 L 6.5 11.5 L 13 4"
                    Stroke="#FF09090D"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <ContentPresenter Margin="8,0,0,0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CheckMarkBorder" Property="BorderBrush" Value="{StaticResource GlassCardBorderHoverBrush}" />
              <Setter TargetName="CheckMarkBorder" Property="Background" Value="#25FFFFFF" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckMarkBorder" Property="Background" Value="{StaticResource SoulEmeraldBrush}" />
              <Setter TargetName="CheckMarkBorder" Property="BorderBrush" Value="{StaticResource SoulEmeraldBrush}" />
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Minimalist Custom Slider (Mac/iOS Island Inspired) -->
  <Style x:Key="SliderThumbStyle" TargetType="Thumb">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="14" Height="14">
            <Ellipse Fill="#FCFFFFFF" Stroke="#FF38BDF8" StrokeThickness="1.5" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Width" Value="16" />
              <Setter Property="Height" Value="16" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="4" CornerRadius="2" Background="#24FFFFFF" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge">
                  <RepeatButton.Template>
                    <ControlTemplate>
                        <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}">
                      </Border>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge">
                  <RepeatButton.Template>
                    <ControlTemplate>
                      <Border Height="4" CornerRadius="2" Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumbStyle}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Minimalist Custom ProgressBar (Pill Timeline) -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="3" />
    <Setter Property="Background" Value="#1CFFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5">
            <Grid x:Name="PART_Indicator" ClipToBounds="True" HorizontalAlignment="Left">
              <Border Background="{TemplateBinding Foreground}" CornerRadius="1.5" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Modern ToggleButton (Quiet Mode / Switches) -->
  <Style TargetType="ToggleButton">
    <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="toggleBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="toggleBorder" Property="Background" Value="{StaticResource GlassCardHoverBrush}" />
              <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{StaticResource GlassCardBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="toggleBorder" Property="Background" Value="{StaticResource AccentGlassBrush}" />
              <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ultra-Minimalist ScrollBar (4px slim, obsidian translucent) -->
  <Style x:Key="MinimalistScrollBarThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="thumbBorder"
                  Background="#38FFFFFF"
                  CornerRadius="2"
                  Margin="1" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="thumbBorder" Property="Background" Value="#6AFFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource MinimalistScrollBarThumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Width" Value="5" />
      </Trigger>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="5" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
