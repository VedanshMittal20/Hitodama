<Window x:Class="Companion.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hitodama Studio · Soul Architect" Height="780" Width="980"
        MinHeight="660" MinWidth="840" WindowStartupLocation="CenterScreen"
        Background="{StaticResource IslandBaseBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top Header Bar with Engine Status Pill -->
    <DockPanel Margin="0,0,0,20">
      <!-- Right Status Badge -->
      <Border DockPanel.Dock="Right" VerticalAlignment="Center"
              Background="{StaticResource GlassCardBrush}"
              BorderBrush="{StaticResource GlassCardBorderBrush}"
              BorderThickness="1" CornerRadius="20" Padding="12,6">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource SoulEmeraldBrush}"
                  VerticalAlignment="Center" Margin="0,0,8,0">
          </Border>
          <TextBlock Text="ENGINE V1.0 · LOCAL RUNTIME" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <!-- Left Title & Subtitle -->
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource AccentGlassBrush}"
                  BorderBrush="{StaticResource AccentBorderBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,10,0">
            <TextBlock Text="STUDIO" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" />
          </Border>
          <TextBlock Text="Shape Your Hitodama" FontSize="22" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>
        <TextBlock Text="Customize neural persona, Windows voice synthesis, encrypted credentials, and local episodic memory."
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,5,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Main Tab Controller -->
    <TabControl Grid.Row="1">

      <!-- ========================================== -->
      <!-- TAB 1: SOUL LOADOUT                        -->
      <!-- ========================================== -->
      <TabItem Header="01   Soul">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
          <StackPanel Margin="0,4,0,12">

            <!-- Slot 1: Soul Identity -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="SLOT 1 · SOUL IDENTITY" Style="{StaticResource CardEyebrow}" DockPanel.Dock="Left" />
                  <TextBlock Text="Visual appearance &amp; callsign" Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11" HorizontalAlignment="Right" />
                </DockPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="280" />
                  </Grid.ColumnDefinitions>

                  <!-- Visual Style Dropdown -->
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="VISUAL AURA STYLE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <ComboBox x:Name="SoulStyleInput" />
                  </StackPanel>

                  <!-- Soul Name Input -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="COMPANION NAME" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="SoulNameInput" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Slot 2: Personality & Prompt -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="SLOT 2 · PERSONALITY &amp; INSTRUCTIONS" Style="{StaticResource CardEyebrow}" DockPanel.Dock="Left" />
                  <TextBlock Text="Directives &amp; tone archetype" Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11" HorizontalAlignment="Right" />
                </DockPanel>

                <TextBlock Text="ARCHETYPE PRESET" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <ComboBox x:Name="PersonalityInput" SelectionChanged="OnPersonalityChanged" Margin="0,0,0,12" />

                <DockPanel Margin="0,0,0,6">
                  <TextBlock Text="SYSTEM INSTRUCTIONS (PROMPT)" FontSize="11" FontWeight="SemiBold"
                             Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                  <TextBlock Text="Defines tone, brevity, and execution boundaries"
                             Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBox x:Name="PersonalityPromptInput" MinHeight="110" MaxHeight="220" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
              </StackPanel>
            </Border>

            <!-- Slot 3: Voice & Model -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="SLOT 3 · VOICE &amp; INFERENCE MODEL" Style="{StaticResource CardEyebrow}" DockPanel.Dock="Left" />
                  <TextBlock Text="Acoustics &amp; Gemini Live endpoint" Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11" HorizontalAlignment="Right" />
                </DockPanel>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Voice Preset -->
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="VOICE PRESET" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <ComboBox x:Name="VoiceInput" />
                  </StackPanel>

                  <!-- Model ID -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="GEMINI LIVE MODEL ID" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="ModelInput" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Slot 4: Abilities -->
            <Border Style="{StaticResource GlassCard}">
              <StackPanel>
                <DockPanel Margin="0,0,0,14">
                  <TextBlock Text="SLOT 4 · ABILITY PACKS" Style="{StaticResource CardEyebrow}" DockPanel.Dock="Left" />
                  <TextBlock Text="Autonomous execution modules" Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11" HorizontalAlignment="Right" />
                </DockPanel>

                <UniformGrid Columns="2">
                  <Border Style="{StaticResource SubCard}">
                    <CheckBox x:Name="SystemAbility">
                      <StackPanel Margin="2,0,0,0">
                        <TextBlock Text="System Controls" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />
                        <TextBlock Text="Hardware volume, brightness, display &amp; power controls"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                      </StackPanel>
                    </CheckBox>
                  </Border>

                  <Border Style="{StaticResource SubCard}">
                    <CheckBox x:Name="DesktopAbility">
                      <StackPanel Margin="2,0,0,0">
                        <TextBlock Text="Desktop UIA" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />
                        <TextBlock Text="Window focus, UI Automation clicks &amp; keyboard automation"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                      </StackPanel>
                    </CheckBox>
                  </Border>

                  <Border Style="{StaticResource SubCard}">
                    <CheckBox x:Name="PlannerAbility">
                      <StackPanel Margin="2,0,0,0">
                        <TextBlock Text="Planner &amp; Routines" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />
                        <TextBlock Text="Scheduled routines, agenda tracking &amp; proactive alarms"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                      </StackPanel>
                    </CheckBox>
                  </Border>

                  <Border Style="{StaticResource SubCard}">
                    <CheckBox x:Name="MediaAbility">
                      <StackPanel Margin="2,0,0,0">
                        <TextBlock Text="Media Island" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />
                        <TextBlock Text="Windows GSMTC media control, track metadata &amp; playback"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                      </StackPanel>
                    </CheckBox>
                  </Border>

                  <Border Style="{StaticResource SubCard}">
                    <CheckBox x:Name="ResearchAbility">
                      <StackPanel Margin="2,0,0,0">
                        <TextBlock Text="Web Research" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />
                        <TextBlock Text="Search, live information retrieval &amp; browser lookups"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                      </StackPanel>
                    </CheckBox>
                  </Border>

                  <Border Style="{StaticResource SubCard}">
                    <CheckBox x:Name="MemoryAbility">
                      <StackPanel Margin="2,0,0,0">
                        <TextBlock Text="Persistent Memory" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />
                        <TextBlock Text="Episodic fact storage across sessions in SQLite database"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                      </StackPanel>
                    </CheckBox>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ========================================== -->
      <!-- TAB 2: CONNECT & TALK                      -->
      <!-- ========================================== -->
      <TabItem Header="02   Connect &amp; talk">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
          <StackPanel Margin="0,4,0,12">

            <!-- Step 1: Create Key -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock Text="01 · GENERATE API KEY" Style="{StaticResource CardEyebrow}" DockPanel.Dock="Left" />
                  <TextBlock Text="Google AI Studio" Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock Text="Create a Gemini API key with access to Gemini Live multimodal audio."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,12" />
                <Button Content="Open Google AI Studio ↗" HorizontalAlignment="Left"
                        Click="OnOpenApiKeyPageClick" Padding="14,8" />
              </StackPanel>
            </Border>

            <!-- Step 2: Paste and Encrypt -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock Text="02 · ENCRYPT &amp; STORE LOCALLY" Style="{StaticResource CardEyebrow}" DockPanel.Dock="Left" />
                  <TextBlock Text="Windows DPAPI Protected" Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock Text="Your API key is encrypted exclusively for your Windows user profile and stored on this PC. It is never logged or transmitted anywhere except direct to Google."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" />

                <DockPanel>
                  <Button Content="Save encrypted key" DockPanel.Dock="Right" Click="OnSaveApiKeyClick"
                          Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                  <PasswordBox x:Name="ApiKeyInput" />
                </DockPanel>

                <!-- Status pill -->
                <Border Margin="0,12,0,0" Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource SoulEmeraldBrush}"
                            VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="ApiKeyStatus" Foreground="{StaticResource SoulEmeraldBrush}"
                               FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Step 3: Global Hotkeys Guide -->
            <Border Style="{StaticResource GlassCard}">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="03 · GLOBAL HOTKEYS &amp; SUMMONING" Style="{StaticResource CardEyebrow}" DockPanel.Dock="Left" />
                  <TextBlock Text="Active anywhere across Windows" Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock Text="Hitodama stays docked at the top of your primary display. Summon or interact instantly using these shortcuts:"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,14" />

                <StackPanel>
                  <!-- Shortcut 1: Talk -->
                  <Border Style="{StaticResource SubCard}" Margin="0,0,0,8" Padding="14,12">
                    <DockPanel>
                      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource KeyBadge}" Margin="0,0,4,0">
                          <TextBlock Text="Ctrl" Style="{StaticResource KeyBadgeText}" />
                        </Border>
                        <TextBlock Text="+" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />
                        <Border Style="{StaticResource KeyBadge}" Margin="0,0,4,0">
                          <TextBlock Text="Alt" Style="{StaticResource KeyBadgeText}" />
                        </Border>
                        <TextBlock Text="+" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />
                        <Border Style="{StaticResource KeyBadge}" Padding="9,2">
                          <TextBlock Text="Space" Style="{StaticResource KeyBadgeText}" />
                        </Border>
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Summon &amp; Talk" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                        <TextBlock Text="Expand the Dynamic Island or toggle bidirectional voice session"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <!-- Shortcut 2: Circle to Ask -->
                  <Border Style="{StaticResource SubCard}" Margin="0,0,0,8" Padding="14,12">
                    <DockPanel>
                      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="Hold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                        <Border Style="{StaticResource KeyBadge}" Margin="0,0,4,0">
                          <TextBlock Text="Ctrl" Style="{StaticResource KeyBadgeText}" />
                        </Border>
                        <TextBlock Text="+" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />
                        <Border Style="{StaticResource KeyBadge}">
                          <TextBlock Text="Shift" Style="{StaticResource KeyBadgeText}" />
                        </Border>
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Circle to Ask" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                        <TextBlock Text="Draw a lasso circle on any screen region with mouse and ask a question out loud"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <!-- Shortcut 3: Clean Dictation -->
                  <Border Style="{StaticResource SubCard}" Margin="0" Padding="14,12">
                    <DockPanel>
                      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="Hold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                        <Border Style="{StaticResource KeyBadge}" Margin="0,0,4,0">
                          <TextBlock Text="Ctrl" Style="{StaticResource KeyBadgeText}" />
                        </Border>
                        <TextBlock Text="+" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />
                        <Border Style="{StaticResource KeyBadge}">
                          <TextBlock Text="Win" Style="{StaticResource KeyBadgeText}" />
                        </Border>
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clean Dictation" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                        <TextBlock Text="Hold keys, speak naturally, and release to stream cleanly formatted text into active cursor"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ========================================== -->
      <!-- TAB 3: MEMORY & AUDIT                      -->
      <!-- ========================================== -->
      <TabItem Header="03   Memory &amp; audit">
        <Grid Margin="0,4,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Left Column: Memories -->
          <Border Grid.Column="0" Style="{StaticResource GlassCard}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="PERSISTENT MEMORIES" Style="{StaticResource CardEyebrow}" DockPanel.Dock="Left" />
                <TextBlock Text="Local episodic database" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" HorizontalAlignment="Right" />
              </DockPanel>

              <!-- Bottom Action Bar -->
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="DeleteMemoryButton" Content="Delete selected"
                        Click="OnDeleteMemoryClick" Style="{StaticResource DangerButton}" Margin="0,0,8,0" />
                <Button Content="Export CSV" Click="OnExportMemoryClick" />
              </StackPanel>

              <!-- Inset Memory List -->
              <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                      CornerRadius="10" Padding="6">
                <ListBox x:Name="MemoryList" DisplayMemberPath="Fact"
                         SelectionChanged="OnMemorySelectionChanged" />
              </Border>
            </DockPanel>
          </Border>

          <!-- Right Column: Security Audit -->
          <Border Grid.Column="2" Style="{StaticResource GlassCard}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="SECURITY AUDIT LOG" Style="{StaticResource CardEyebrow}" DockPanel.Dock="Left" />
                <TextBlock Text="Action trail &amp; confirmations" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" HorizontalAlignment="Right" />
              </DockPanel>

              <!-- Monospace Inset Terminal Viewer -->
              <Border Background="#120A0A0E" BorderBrush="#18FFFFFF" BorderThickness="1"
                      CornerRadius="10" Padding="10">
                <TextBox x:Name="AuditText" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Cascadia Code, Segoe UI Variable Text" FontSize="11.5"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Background="Transparent" BorderThickness="0" Padding="0" />
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

    </TabControl>

    <!-- Bottom Footer Bar -->
    <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0"
            BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}"
                  VerticalAlignment="Center" Margin="0,0,8,0">
          </Border>
          <TextBlock x:Name="SaveStatus" Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <Button Content="Save loadout" DockPanel.Dock="Right" Click="OnSaveLoadoutClick"
                Style="{StaticResource PrimaryButton}" Padding="22,9" FontSize="13" />
      </DockPanel>
    </Border>

  </Grid>
</Window>
